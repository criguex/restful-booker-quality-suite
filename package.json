{
  "name": "restful-booker-quality-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-shaped API quality framework for Restful Booker using Playwright, TypeScript and contract testing",
  "author": "Cristian Guerra (@criguex)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:contract": "playwright test --project=contract",
    "test:performance": "playwright test --project=performance",
    "test:smoke": "playwright test --project=api --grep @smoke",
    "test:negative": "playwright test --project=api --grep @negative",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.7.2",
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "eslint-plugin-playwright": "^2.2.2",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "zod": "^4.1.12"
  },
  "keywords": [
    "playwright",
    "typescript",
    "api-testing",
    "contract-testing",
    "qa-automation"
  ]
}
